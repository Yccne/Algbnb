# Server
PORT=3001
HOST=0.0.0.0
CLIENT_URL=http://127.0.0.1:5173

# PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=projet
PGUSER=postgres
PGPASSWORD=replace_me
PGSSL=false

# Auth
JWT_SECRET=replace_me_with_a_long_random_secret

# Firebase Admin (required for Google auth backend verification)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"

# Geocoding provider for backend routes
LOCATIONIQ_KEY=replace_me

# Optional SMTP for real emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
