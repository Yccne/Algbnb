# Server Configuration
PORT=3001
HOST=0.0.0.0

# PostgreSQL Configuration (REQUIRED)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=projet
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGSSL=false

# JWT Secret (Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_key_here

# Client Configuration
CLIENT_URL=http://localhost:5173

# Firebase Configuration (REQUIRED for Google Authentication)
# Get these from: Firebase Console > Project Settings > Your apps > Web
FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
FIREBASE_PROJECT_ID=your-project-id

# Map Providers (Optional)
VITE_MAPTILER_KEY=your_maptiler_key
VITE_LOCATIONIQ_KEY=your_locationiq_key

# Email Configuration (Optional - for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
SMTP_FROM=
SMTP_SECURE=false
