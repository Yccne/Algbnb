VITE_API_URL=http://127.0.0.1:3001/api

# Firebase client (required for Google auth)
VITE_FIREBASE_API_KEY=replace_me
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789123
VITE_FIREBASE_APP_ID=1:123456789123:web:abcd1234efgh5678ijkl
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Maps and geocoding
VITE_MAPTILER_KEY=replace_me
VITE_LOCATIONIQ_KEY=replace_me
